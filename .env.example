# Copy to .env and fill in the credentials you have.
# Every platform is optional: unconfigured ones are reported as failed
# with "missing credentials: <ENV_VAR>" and never block the others.

# Bluesky - Settings > App Passwords (https://bsky.app/settings/app-passwords)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=https://bsky.social

# Mastodon - Preferences > Development > New application (scope: write:statuses)
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=

# Dev.to - https://dev.to/settings/extensions > DEV Community API Keys
DEVTO_API_KEY=

# WordPress (self-hosted or Jetpack) - Users > Profile > Application Passwords
# The site must be served over HTTPS for Application Passwords to be accepted.
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Hugging Face - https://huggingface.co/settings/tokens (role: Write)
# HF_REPO is an existing public model repo you own, e.g. yourname/automated-posting-demo
HF_TOKEN=
HF_REPO=
